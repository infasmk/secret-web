rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isNotExpired(expiresAt) {
      return request.time < expiresAt;
    }

    // Rooms collection
    match /rooms/{roomId} {
      // Allow reading metadata if room is not expired
      allow read: if isNotExpired(resource.data.expiresAt);
      
      // Allow creation with valid fields, future expiration, and sane limits
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasAll(['id', 'createdAt', 'expiresAt', 'status'])
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd')
        && request.resource.data.status == 'active';
        
      // Only creator or participant can mark room destroyed or update status
      allow update: if isAuthenticated()
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'destructionReason']))
        && (request.resource.data.status in ['active', 'expired', 'destroyed']);

      // Hard deletion reserved for server-side Cloud Function sweepers
      allow delete: if false;

      // Ephemeral Room Members subcollection
      match /members/{memberId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated()
          && request.resource.data.keys().hasAll(['displayName', 'joinedAt', 'lastSeenAt']);
        allow delete: if isAuthenticated() && request.auth.uid == memberId;
      }

      // Ephemeral Messages subcollection (ciphertext only)
      match /messages/{messageId} {
        // Can only read messages if room is not expired
        allow read: if isAuthenticated()
          && isNotExpired(get(/databases/$(database)/documents/rooms/$(roomId)).data.expiresAt);

        // Can only write encrypted ciphertext with valid payload structure
        allow create: if isAuthenticated()
          && request.resource.data.keys().hasAll(['senderId', 'type', 'encryptedContent', 'createdAt'])
          && request.resource.data.encryptedContent.keys().hasAll(['iv', 'ciphertext'])
          && request.resource.data.encryptedContent.ciphertext.size() < 100000;

        // Can only update to mark view-once media burned
        allow update: if isAuthenticated()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isBurned', 'viewedBy', 'burnedAt']);

        allow delete: if false;
      }
    }
  }
}
