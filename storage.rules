rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /vault/{roomId}/{fileId} {
      // Allow reading encrypted binary blob if authenticated and authorized
      allow read: if request.auth != null;
      
      // Allow uploading encrypted binary payload under 25MB with valid metadata
      allow write: if request.auth != null
        && request.resource.size < 25 * 1024 * 1024;
        
      // Allow deletion upon view-once consumption or room killswitch
      allow delete: if request.auth != null;
    }
  }
}
